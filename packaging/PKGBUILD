# Maintainer: Julian <juwolf11@googlemail.com>
pkgname=ssh-first
pkgver=0.3.2
pkgrel=1
pkgdesc="A focused SSH and SFTP workspace"
arch=('x86_64')
url="https://github.com/junet-1/sshfirst"
license=('MIT')
# Runtime: the default Wails v3 backend links GTK4 + WebKitGTK 6.0.
depends=('gtk4' 'webkitgtk-6.0')
makedepends=('go' 'nodejs' 'npm' 'pkgconf')
optdepends=('rsync: file transfers (SFTP sync)'
            'gnome-keyring: password storage via the Secret Service API'
            'kwallet: password storage via the Secret Service API (KDE)')
# Built in-tree from this checkout (frontend bindings are committed, so wails3
# is not needed at package time). No remote source.
source=()

build() {
  cd "$startdir/.."

  # Frontend: install deps and produce frontend/dist (embedded into the binary).
  # APP_VERSION is what vite.config.ts substitutes for __APP_VERSION__, so
  # without it the About dialog of an Arch build reports 0.0.0-dev.
  ( cd frontend && npm ci && APP_VERSION="$pkgver" npm run build )

  # Production binary. CGO must be on for the GTK/WebKit bridge; default build
  # tags select the GTK4 + webkitgtk-6.0 backend.
  export CGO_ENABLED=1
  export GOFLAGS="-mod=readonly -modcacherw"
  go build -trimpath -buildvcs=false -tags production -ldflags='-w -s' \
    -o build/bin/ssh-first .
}

package() {
  cd "$startdir/.."

  install -Dm755 build/bin/ssh-first "$pkgdir/usr/bin/ssh-first"

  # Application-menu entry + icons (pixmaps is the guaranteed fallback for the
  # Icon=ssh-first name; hicolor carries the full-res icon for HiDPI themes).
  # Wails exposes org.wails.ssh_first as its GTK application ID. Matching the
  # desktop filename to it lets KDE/GNOME resolve the correct taskbar icon;
  # StartupWMClass in the file additionally covers the XWayland window class.
  install -Dm644 packaging/ssh-first.desktop "$pkgdir/usr/share/applications/org.wails.ssh_first.desktop"
  install -Dm644 build/appicon.png "$pkgdir/usr/share/pixmaps/ssh-first.png"
  install -Dm644 build/appicon.png "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/ssh-first.png"

  # Start in the tray on login without opening the main window.
  install -Dm644 packaging/ssh-first-autostart.desktop "$pkgdir/etc/xdg/autostart/ssh-first.desktop"
}
